---
const { src, reverse, classes, imgWidth } = Astro.props;
import CfImage from "./CfImage.tsx";
---

<div class={`relative flex-none ${classes}`}>
  <div
    class={`z-0 absolute aspect-[4/5] w-full rounded-2xl bg-red-400 shadow-inner shadow-red-800 transform ${reverse ? "rotate-3" : "-rotate-3"}`}
  >
  </div>
  <CfImage
    classes={`z-10 relative aspect-[4/5] w-full flex-none rounded-2xl object-cover self-start ring-1 ring-emerald-50 ring-opacity-30 transform ${reverse ? "-rotate-3" : "rotate-3"}`}
    image={src}
    is_bw={false}
    width={imgWidth || 400}
  />
</div>
